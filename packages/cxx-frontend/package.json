{
  "name": "cxx-frontend",
  "version": "1.2.0",
  "description": "A compiler front end for the C++ language",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "default": "./dist/parse.js"
    },
    "./link": {
      "types": "./dist/link.d.ts",
      "default": "./dist/link.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "default": "./dist/model.js"
    },
    "./traverse": {
      "types": "./dist/traverse.d.ts",
      "default": "./dist/traverse.js"
    },
    "./lsp": {
      "types": "./dist/lsp.d.ts",
      "default": "./dist/lsp.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./wasm": "./dist/wasm/cxx-js.wasm",
    "./package.json": "./package.json"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "browser": {
    "url": false
  },
  "scripts": {
    "watch": "watchexec --print-events -r npm run build",
    "build": "tsc",
    "test": "tsc -p test/tsconfig.json && node --test test/*.test.mjs",
    "example": "node examples/cxx-parse/index.js",
    "docs": "typedoc",
    "prettier": "npx prettier --check .",
    "prettier:fix": "npx prettier --write . ",
    "prepack": "node scripts/prepack.mjs"
  },
  "keywords": [
    "c++",
    "compiler",
    "mlir",
    "wasm"
  ],
  "author": {
    "name": "Roberto Raggi",
    "email": "roberto.raggi@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/robertoraggi/cplusplus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertoraggi/cplusplus.git",
    "directory": "packages/cxx-frontend"
  },
  "bugs": {
    "url": "https://github.com/robertoraggi/cplusplus/issues"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.6",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
