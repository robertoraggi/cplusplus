{
  "name": "cxx-frontend",
  "version": "1.2.0",
  "description": "A compiler front end for the C++ language",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "default": "./dist/parse.js"
    },
    "./model": {
      "types": "./dist/Semantic.d.ts",
      "default": "./dist/Semantic.js"
    },
    "./traverse": {
      "types": "./dist/Traverse.d.ts",
      "default": "./dist/Traverse.js"
    },
    "./lsp": {
      "types": "./dist/LanguageServer.d.ts",
      "default": "./dist/LanguageServer.js"
    },
    "./wasm": "./dist/wasm/cxx-js.wasm",
    "./package.json": "./package.json"
  },
  "type": "module",
  "browser": {
    "url": false
  },
  "scripts": {
    "watch": "watchexec --print-events -r npm run build",
    "build": "tsc",
    "test": "tsc -p test/tsconfig.json && node --test test/*.test.mjs",
    "example": "node examples/cxx-parse/index.js",
    "docs": "typedoc src/index.ts src/parse.ts src/Semantic.ts src/Traverse.ts src/LanguageServer.ts",
    "prettier": "npx prettier --check .",
    "prettier:fix": "npx prettier --write . "
  },
  "keywords": [
    "c++",
    "compiler",
    "lexer",
    "parser",
    "preprocessor",
    "syntax"
  ],
  "author": {
    "name": "Roberto Raggi",
    "email": "roberto.raggi@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertoraggi/cplusplus.git"
  },
  "bugs": {
    "url": "https://github.com/robertoraggi/cplusplus/issues"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.6",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.2"
  }
}
