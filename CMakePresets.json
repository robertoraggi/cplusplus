{
  "version": 7,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "default",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "YES",
        "CXX_INSTALL_WASI_SYSROOT": "YES"
      }
    },
    {
      "inherits": "default",
      "name": "debug",
      "displayName": "debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "NO"
      }
    },
    {
      "inherits": "debug",
      "name": "debug-asan",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -g -O1",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address"
      }
    },
    {
      "name": "emscripten-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build.em",
      "toolchainFile": "$env{EMSCRIPTEN_ROOT}/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build.em/install/usr",
        "EMSCRIPTEN_ROOT_PATH": "$env{EMSCRIPTEN_ROOT}",
        "CXX_INSTALL_WASI_SYSROOT": "YES"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "$env{EMSCRIPTEN_ROOT}",
        "rhs": ""
      }
    },
    {
      "name": "emscripten",
      "displayName": "emscripten",
      "inherits": "emscripten-base",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "YES",
        "CXX_ENABLE_MLIR": "NO"
      }
    },
    {
      "name": "default-mlir",
      "displayName": "default with MLIR",
      "inherits": "default",
      "cacheVariables": {
        "CXX_ENABLE_MLIR": "YES"
      }
    },
    {
      "name": "debug-mlir",
      "displayName": "debug with MLIR",
      "inherits": "debug",
      "cacheVariables": {
        "CXX_ENABLE_MLIR": "YES"
      }
    },
    {
      "name": "emscripten-mlir",
      "displayName": "emscripten with MLIR",
      "inherits": "emscripten-base",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "NO",
        "CXX_ENABLE_MLIR": "YES",
        "LLVM_DIR": "${sourceDir}/build.em/llvm-project/install/lib/cmake/llvm",
        "MLIR_DIR": "${sourceDir}/build.em/llvm-project/install/lib/cmake/mlir"
      }
    },
    {
      "name": "wasi",
      "displayName": "wasi",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build.wasi",
      "toolchainFile": "$env{WASI_SDK_PATH}/share/cmake/wasi-sdk.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build.wasi/install/usr",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "YES",
        "CXX_INSTALL_WASI_SYSROOT": "YES"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "$env{WASI_SDK_PATH}",
        "rhs": ""
      }
    },
    {
      "name": "wasi-threads",
      "inherits": "wasi",
      "toolchainFile": "$env{WASI_SDK_PATH}/share/cmake/wasi-sdk-pthread.cmake"
    },
    {
      "name": "self-host-mlir",
      "hidden": true,
      "inherits": "default-mlir",
      "toolchainFile": "${sourceDir}/scripts/cxx-native-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "NO",
        "CMAKE_CXX_FLAGS": "-fno-exceptions -DSIMDJSON_IMPLEMENTATION_ARM64=0 -DSIMDJSON_EXPERIMENTAL_HAS_NEON=0 -DSIMDJSON_EXPERIMENTAL_HAS_SSE2=0 -DSIMDJSON_IMPLEMENTATION_ICELAKE=0 -DSIMDJSON_IMPLEMENTATION_HASWELL=0 -DSIMDJSON_IMPLEMENTATION_WESTMERE=0",
        "CXX_BUILD_TESTS": "OFF",
        "CXX_ENABLE_MIMALLOC": "OFF",
        "LLVM_ENABLE_LIBCXX": "ON",
        "FETCHCONTENT_SOURCE_DIR_SIMDJSON": "${sourceDir}/build/_deps/simdjson-src",
        "FETCHCONTENT_SOURCE_DIR_WASI_SYSROOT": "${sourceDir}/build/_deps/wasi_sysroot-src",
        "FETCHCONTENT_SOURCE_DIR_WASI_BUILTINS": "${sourceDir}/build/_deps/wasi_builtins-src"
      }
    },
    {
      "name": "stage1",
      "displayName": "Self-host stage 1 with MLIR",
      "inherits": "self-host-mlir",
      "binaryDir": "${sourceDir}/build-stage1",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "${sourceDir}/build/src/frontend/cxx",
        "CMAKE_CXX_COMPILER": "${sourceDir}/build/src/frontend/cxx",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build-stage1/install"
      }
    },
    {
      "name": "stage2",
      "displayName": "Self-host stage 2 with MLIR",
      "inherits": "self-host-mlir",
      "binaryDir": "${sourceDir}/build-stage2",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "${sourceDir}/build-stage1/src/frontend/cxx",
        "CMAKE_CXX_COMPILER": "${sourceDir}/build-stage1/src/frontend/cxx",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build-stage2/install"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "debug",
      "configurePreset": "default"
    },
    {
      "name": "install",
      "configurePreset": "default",
      "targets": ["install"]
    },
    {
      "name": "build-emscripten",
      "configurePreset": "emscripten"
    },
    {
      "name": "build-emscripten-mlir",
      "configurePreset": "emscripten-mlir",
      "targets": ["cxx-js", "link_cxx_include", "link_wasi_sysroot"]
    },
    {
      "name": "install-emscripten",
      "configurePreset": "emscripten",
      "targets": ["install"]
    },
    {
      "name": "build-wasi",
      "configurePreset": "wasi"
    },
    {
      "name": "install-wasi",
      "configurePreset": "wasi",
      "targets": ["install"]
    },
    {
      "name": "build-wasi-threads",
      "configurePreset": "wasi-threads"
    },
    {
      "name": "install-wasi-threads",
      "configurePreset": "wasi-threads",
      "targets": ["install"]
    },
    {
      "name": "stage1",
      "configurePreset": "stage1",
      "targets": ["cxx", "link_cxx_include", "link_wasi_sysroot"],
      "cleanFirst": true
    },
    {
      "name": "stage2",
      "configurePreset": "stage2",
      "targets": ["cxx", "link_cxx_include", "link_wasi_sysroot"],
      "cleanFirst": true
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "emscripten",
      "configurePreset": "emscripten"
    }
  ],
  "workflowPresets": [
    {
      "name": "default",
      "steps": [
        {
          "type": "configure",
          "name": "default"
        },
        {
          "type": "build",
          "name": "default"
        },
        {
          "type": "test",
          "name": "default"
        },
        {
          "type": "build",
          "name": "install"
        }
      ]
    },
    {
      "name": "emscripten",
      "steps": [
        {
          "type": "configure",
          "name": "emscripten"
        },
        {
          "type": "build",
          "name": "build-emscripten"
        },
        {
          "type": "build",
          "name": "install-emscripten"
        }
      ]
    },
    {
      "name": "wasi",
      "steps": [
        {
          "type": "configure",
          "name": "wasi"
        },
        {
          "type": "build",
          "name": "install-wasi"
        }
      ]
    },
    {
      "name": "wasi-threads",
      "steps": [
        {
          "type": "configure",
          "name": "wasi-threads"
        },
        {
          "type": "build",
          "name": "install-wasi-threads"
        }
      ]
    },
    {
      "name": "stage1",
      "steps": [
        {
          "type": "configure",
          "name": "stage1"
        },
        {
          "type": "build",
          "name": "stage1"
        }
      ]
    },
    {
      "name": "stage2",
      "steps": [
        {
          "type": "configure",
          "name": "stage2"
        },
        {
          "type": "build",
          "name": "stage2"
        }
      ]
    }
  ]
}
