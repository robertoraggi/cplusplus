class exception : public std::exception {
 private:
  string __what_;
  u8string __u8what_;
  info __from_;
  source_location __where_;

  static consteval string __to_ordinary(u8string_view text) {
    return string(text.begin(), text.end());
  }

  static consteval u8string __to_utf8(string_view text) {
    return u8string(text.begin(), text.end());
  }

 public:
  consteval exception(u8string_view what, info from,
                      source_location where = source_location::current()) noexcept
      : __what_(__to_ordinary(what)),
        __u8what_(what),
        __from_(from),
        __where_(where) {}

  consteval exception(string_view what, info from,
                      source_location where = source_location::current()) noexcept
      : __what_(what),
        __u8what_(__to_utf8(what)),
        __from_(from),
        __where_(where) {}

  exception(const exception&) = default;
  exception(exception&&) = default;

  exception& operator=(const exception&) = default;
  exception& operator=(exception&&) = default;

  constexpr const char* what() const noexcept override {
    return __what_.c_str();
  }
  consteval u8string_view u8what() const noexcept { return __u8what_; }
  consteval info from() const noexcept { return __from_; }
  consteval source_location where() const noexcept { return __where_; }
};

