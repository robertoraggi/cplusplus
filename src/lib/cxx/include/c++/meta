namespace __detail {
template <class T>
inline constexpr bool __tuple_like_v = false;
template <class T, size_t N>
inline constexpr bool __tuple_like_v<array<T, N>> = true;
template <class T>
inline constexpr bool __tuple_like_v<complex<T>> = true;
template <class T, class U>
inline constexpr bool __tuple_like_v<pair<T, U>> = true;
template <class... T>
inline constexpr bool __tuple_like_v<tuple<T...>> = true;
template <class I, class S, ranges::subrange_kind K>
inline constexpr bool __tuple_like_v<ranges::subrange<I, S, K>> = true;

template <class Fn, class Tuple, class Indices>
struct __apply_traits;

template <class Fn, class Tuple, size_t... N>
  requires __tuple_like_v<remove_cvref_t<Tuple>>
struct __apply_traits<Fn, Tuple, index_sequence<N...>> {
  static constexpr bool applicable =
      is_invocable_v<Fn, decltype(get<N>(declval<Tuple>()))...>;
  static constexpr bool nothrow_applicable =
      is_nothrow_invocable_v<Fn, decltype(get<N>(declval<Tuple>()))...>;
  using result = std::invoke_result<Fn, decltype(get<N>(declval<Tuple>()))...>;
};

template <class Fn, class Tuple>
using __apply_traits_t = __apply_traits<
    Fn, Tuple, make_index_sequence<tuple_size_v<remove_reference_t<Tuple>>>>;

template <class Fn, class Tuple>
inline constexpr bool __is_applicable_v = false;
template <class Fn, class Tuple>
  requires requires { __apply_traits_t<Fn, Tuple>::applicable; }
inline constexpr bool __is_applicable_v<Fn, Tuple> =
    __apply_traits_t<Fn, Tuple>::applicable;

template <class Fn, class Tuple>
inline constexpr bool __is_nothrow_applicable_v = false;
template <class Fn, class Tuple>
  requires requires { __apply_traits_t<Fn, Tuple>::nothrow_applicable; }
inline constexpr bool __is_nothrow_applicable_v<Fn, Tuple> =
    __apply_traits_t<Fn, Tuple>::nothrow_applicable;

template <class Fn, class Tuple>
using __apply_result_t = __apply_traits_t<Fn, Tuple>::result::type;
}

consteval bool is_applicable_type(info fn, info tuple) {
  return extract<bool>(substitute(^^__detail::__is_applicable_v, {fn, tuple}));
}

consteval bool is_nothrow_applicable_type(info fn, info tuple) {
  return extract<bool>(
      substitute(^^__detail::__is_nothrow_applicable_v, {fn, tuple}));
}

consteval info apply_result(info fn, info tuple) {
  return dealias(substitute(^^__detail::__apply_result_t, {fn, tuple}));
}
